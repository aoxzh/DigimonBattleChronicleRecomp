FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Digimon Battle Chronicle (GameCube recompilation)"
      VALUE "ProductName", "Digimon Battle Chronicle desktop port"
      VALUE "OriginalFilename", "main_gx.exe"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
